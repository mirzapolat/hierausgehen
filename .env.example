# Die App braucht keine Schlüssel oder Zugangsdaten – sie liest ausschliesslich
# öffentliche Spielpläne. Diese Datei ist deshalb rein optional; ohne sie gelten
# die Vorgaben aus docker-compose.yml.

# Zeitzone des Containers (Logs, Bezugsmonat mancher Quellen).
TZ=Europe/Berlin

# Zwischenspeicher auf Platte: 1 = an (Vorgabe), 0 = aus.
EVENT_CACHE_DISK=1

# Bedeutungssuche der Suchseite: 1 = an (Vorgabe), 0 = nur Wortsuche.
# Das Modell liegt im Abbild und braucht keinen Schlüssel, aber gut 400 MB
# Arbeitsspeicher, sobald die erste Suche läuft.
EVENT_SEMANTIC=1
