# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Zwischenspeicher der Quellen (Termine und Favicons)
/.cache
.probe/

# Demo-Datenbank für `npm run dev` (Abzug der Live-Seite, `npm run demo:pull`).
# Gut 25 MB, die bei jedem Abzug neu wären – gehört nicht in die Historie.
/demo

# Rohantworten einer Quelle, lokal abgelegt. Auf dem Server schreibt der
# Container in dieses Verzeichnis – deshalb darf der Deploy es nicht anfassen
# (rsync bekäme "Permission denied" und bräche den ganzen Lauf ab).
/.mirror

# Ausgeleitete Datenstände (CSV-Export, Tabellen daraus)
/hierausgehen-*.csv
/*.numbers

# Umgebungsvariablen (die echte Datei liegt auf dem Server)
.env
.env.*
!.env.example
